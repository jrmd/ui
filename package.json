{
  "name": "jez-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @jez-ui/catalogue dev",
    "generate": "node scripts/build-registry.mjs",
    "build": "pnpm generate && pnpm --filter @jez-ui/catalogue build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "pnpm generate && pnpm typecheck && pnpm lint && node scripts/verify.mjs",
    "test": "playwright test",
    "templates:build": "node scripts/build-templates.mjs",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
    "test:composition": "tsc --noEmit -p fixtures/composition/tsconfig.json && playwright test -c playwright.composition.config.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.3",
    "three": "0.183.2",
    "@fontsource-variable/instrument-sans": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.1.4",
    "ajv": "8.18.0",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "shadcn": "4.0.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "7.3.1"
  }
}
